        <mxCell id="title" value="Figure 3 — Hardware &amp; Software Deployment Architecture (Physical IoT Node ⇄ Wi-Fi LAN ⇄ Docker on Mac)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#080C14;strokeColor=#38BDF8;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
